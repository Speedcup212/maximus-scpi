# Variables d'environnement pour Vite
# Local: placer ces valeurs dans .env.local (non versionné)
# Production (Netlify): Site settings → Environment variables

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=

# ── Prerender.io (SEO bot pre-rendering) ──
# Token from https://prerender.io → Dashboard → Settings → Token
# Set in Netlify: Site settings → Environment variables
PRERENDER_TOKEN=

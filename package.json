{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "prebuild": "npx tsx scripts/generateSitemapFromDB.ts && cross-env NODE_ENV=production npx tsx scripts/generateRobotsTxt.ts && node scripts/generateRedirectsSSG.js",
    "build": "npx vite build && node scripts/inject-async-css.js && node scripts/generateOptimizedStaticPages.js && node scripts/generateArticleStaticPages.js && node scripts/generateArticlesFromTSX.js && node scripts/generateOptimizedThematicPages.js && node scripts/generateComprendrePage.js && node scripts/generateIrokoZenStaticPage.js && node scripts/inject-env-vars.js && node scripts/copyFinalSitemapToDist.js && node scripts/assertFinalSitemap.js",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "npx vite preview",
    "force-reload": "node scripts/force-reload-simple.cjs",
    "typecheck": "tsc -b",
    "audit:scpi-indicators": "npx tsx scripts/scpi-agents/audit-all-scpi-indicators.ts",
    "audit:scpi-consistency": "npx tsx scripts/scpi-agents/audit-visible-scpi-price-reconstitution-consistency.ts",
    "check:scpi-usages": "npx tsx scripts/scpi-agents/check-forbidden-scpi-usages.ts",
    "test:scpi-text-consistency": "npx tsx scripts/scpi-agents/test-analysis-text-discount-consistency.ts",
    "audit:scpi-pages": "npx tsx scripts/scpi-agents/audit-scpi-page-template-consistency.ts",
    "audit:scpi-seo": "node scripts/generateRedirectsSSG.js && npx tsx scripts/scpi-agents/audit-scpi-seo-canonical-consistency.ts",
    "qa:scpi": "npm run audit:scpi-indicators && npm run audit:scpi-consistency && npm run audit:scpi-pages && npm run audit:scpi-seo && npm run test:scpi-text-consistency && npm run check:scpi-usages && npx vite build",
    "news:investments": "npx tsx scripts/scpi-investment-news-watcher.ts",
    "video:acquisitions": "npm run news:investments && npx tsx scripts/scpi-agents/build-scpi-video-acquisition-candidates.ts",
    "seo:audit-indexation": "node scripts/seo/audit-indexation.mjs",
    "deploy": "npm run build && gh-pages -d dist",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@sparticuz/chromium": "^133.0.0",
    "@supabase/supabase-js": "^2.58.0",
    "axios": "^1.18.1",
    "decimal.js": "^10.6.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "lucide-react": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.4.1",
    "remark-gfm": "^4.0.1",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.7.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "gh-pages": "^6.3.0",
    "globals": "^15.9.0",
    "pdf-parse": "^1.1.4",
    "postcss": "^8.4.35",
    "puppeteer": "^24.43.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.21",
    "vitest": "^4.0.18"
  }
}
